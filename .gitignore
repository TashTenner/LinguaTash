.contentlayer

# TypeScript incremental cache: 2.9 MB, regenerated by every tsc run
tsconfig.tsbuildinfo

# Claude Code permissions. Both hold absolute paths from one machine, so
# neither is useful to anyone else; the .local one is personal by convention.
.claude/settings.json
.claude/settings.local.json
